df
library(readxl)
library(tidyverse)
library(lubridate)
# ========== 1. 读取Excel ==========
# 替换为你的文件路径
df <- read_excel("processed_data/第三组_需求统计.xlsx")
# ========== 2. 构建时间列 ==========
df <- df %>%
mutate(
date = ymd(paste(year, month, "01"))
) %>%
arrange(date)
# ========== 3. 构建季节背景色 ==========
# 定义季节
get_season <- function(date) {
m <- month(date)
if (m %in% c(12, 1, 2)) return("Winter")
if (m %in% c(3, 4, 5)) return("Spring")
if (m %in% c(6, 7, 8)) return("Summer")
if (m %in% c(9, 10, 11)) return("Autumn")
}
df <- df %>%
mutate(season = sapply(date, get_season))
# ========== 4. 绘图 ==========
# 要绘制的需求列
# demand_cols <- c("demand1", "demand2", "demand3")  # 多列
demand_cols <- c("demand")                 # 单列
# 转成长格式（tidy）
df_long <- df %>%
pivot_longer(
cols = all_of(demand_cols),
names_to = "demand_type",
values_to = "count"
)
# 季节填充数据
season_rects <- df %>%
group_by(season) %>%
summarise(
start = min(date),
end = max(date)
) %>%
mutate(
fill_color = case_when(
season == "Winter" ~ "lightblue",
season == "Spring" ~ "lightgreen",
season == "Summer" ~ "mistyrose",
season == "Autumn" ~ "lightyellow"
)
)
# 绘图
ggplot() +
# 添加季节背景
geom_rect(
data = season_rects,
aes(
xmin = start,
xmax = end,
ymin = -Inf,
ymax = Inf,
fill = fill_color
),
alpha = 0.3
) +
scale_fill_identity() + # 使用自定义颜色
# 折线图
geom_line(
data = df_long,
aes(x = date, y = count, color = demand_type),
size = 1
) +
geom_point(
data = df_long,
aes(x = date, y = count, color = demand_type),
size = 2
) +
# 美化
scale_x_date(date_labels = "%Y-%m", date_breaks = "3 months") +
theme_minimal(base_size = 14) +
labs(
title = "Demand Trend Over Time",
x = "Date",
y = "Count",
color = "Demand Type"
) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1)
)
